const ZHIPU_API_KEY = process.env.ZHIPU_API_KEY || "";
const MODEL_CHAT = "glm-4-flash";
const API_URL = "https://open.bigmodel.cn/api/paas/v4/chat/completions";

const stylePrompts = {
  "文艺": "文艺淡雅，富有诗意",
  "喜庆": "欢快热闹，充满喜悦",
  "美丽": "赞美风景，心情愉悦",
  "怀旧": "温馨怀旧，岁月感"
};
const musicMap = {
  "文艺": "classical", "喜庆": "happy", "美丽": "nature", "怀旧": "nostalgia"
};

export async function POST(request) {
  try {
    const data = await request.json();
    const imageDesc = data.image_desc || "";
    const speechText = data.speech_text || "";
    const style = data.style || "文艺";
    const prompt = `请帮我生成一段适合老年人分享的家庭多媒体日记文案。

图片描述：${imageDesc}
老人语音讲述：${speechText}
选择风格：${style}（${stylePrompts[style] || ""}）

请返回 JSON 格式（不要加\`\`\`）：
{
  "title": "一句话标题（不超过15字）",
  "subtitle": "副标题/日期一句话（不超过20字）",
  "captions": ["字幕短句1", "字幕短句2", "字幕短句3"],
  "music": "${musicMap[style] || "classical"}"
}

要求：
- 语言要亲切温暖，像写日记一样
- 字幕短句每句不超过12字，适合大字展示
- 日期用"今天"或"XX年XX月"即可`;
    const resp = await fetch(API_URL, {
      method: "POST",
      headers: {
        "Authorization": `Bearer ${ZHIPU_API_KEY}`,
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        model: MODEL_CHAT,
        messages: [
          { role: "system", content: "你是一位贴心的AI助手，擅长帮老年人把生活点滴变成温暖的多媒体日记。严格按JSON格式输出。" },
          { role: "user", content: prompt }
        ],
        max_tokens: 1024, temperature: 0.7
      })
    });
    const respData = await resp.json();
    if (resp.ok && respData.choices) {
      let content = respData.choices[0].message.content.trim();
      if (content.startsWith("```")) {
        content = content.split("\n").slice(1, -1).join("\n");
      }
      try {
        const result = JSON.parse(content.trim());
        result.ok = true;
        return Response.json(result);
      } catch {}
    }
    return Response.json({
      ok: true, title: speechText.slice(0, 10) || "美好的一天",
      subtitle: "今天的美好回忆",
      captions: [speechText.slice(0, 10) || "时光缓缓流淌", "这一刻值得珍藏", "愿岁月温柔以待"],
      music: musicMap[style] || "classical"
    });
  } catch (e) {
    return Response.json({
      ok: true, title: "美好回忆", subtitle: "今天的记录",
      captions: ["岁月静好", "温暖相伴", "铭记此刻"], music: "classical"
    });
  }
}
export function GET() { return Response.json({ ok: true }); }