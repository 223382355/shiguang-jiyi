// 鍚庣 API 灏佽
const API = {
    async analyzeImage(base64) {
        const resp = await fetch("/api/analyze_image", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ image_base64: base64 })
        });
        const data = await resp.json();
        if (!data.ok) throw new Error(data.error || "鍥剧墖璇嗗埆澶辫触");
        return data;
    },

    async speechToText(blob, mimeType) {
        const form = new FormData();
        form.append("audio", blob, "speech.webm");
        const resp = await fetch("/api/speech_to_text", {
            method: "POST", body: form
        });
        const data = await resp.json();
        if (!data.ok) throw new Error(data.error || "璇煶璇嗗埆澶辫触");
        return data;
    },

    async generateContent(imageDesc, speechText, style) {
        const resp = await fetch("/api/generate_content", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ image_desc: imageDesc, speech_text: speechText, style: style })
        });
        const data = await resp.json();
        if (!data.ok) throw new Error(data.error || "鏂囨鐢熸垚澶辫触");
        return data;
    }
};